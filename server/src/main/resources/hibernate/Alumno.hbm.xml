<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="edu.ar.tempus.feature.alumno.model">

    <joined-subclass name="edu.ar.tempus.feature.alumno.model.Alumno"
                     extends="edu.ar.tempus.model.Usuario"
                     table="alumno">

        <key column="usuario_id"/>

        <many-to-one name="carreraActiva"
                     class="edu.ar.tempus.model.Carrera"
                     column="carrera_activa_id"
                     not-null="false"/>

        <bag name="comisiones" table="usuario_comision" lazy="false">
            <key column="usuario_id"/>
            <many-to-many class="edu.ar.tempus.model.Comision" column="comision_id"/>
        </bag>

        <bag name="materiasAprobadas" table="usuario_materia_aprobada" lazy="false">
            <key column="usuario_id"/>
            <many-to-many class="edu.ar.tempus.model.Materia" column="materia_id"/>
        </bag>

        <bag name="carreras" table="usuario_carrera" lazy="false">
            <key column="usuario_id"/>
            <many-to-many class="edu.ar.tempus.model.Carrera" column="carrera_id"/>
        </bag>

    </joined-subclass>

</hibernate-mapping>